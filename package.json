{
	"name": "yume",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"fix": "biome check --write .",
		"dev:server": "node --experimental-strip-types --watch src/server/index.ts",
		"dev:client": "vite",
		"build": "vite build",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --experimental-strip-types src/server/db/migrate.ts",
		"db:seed": "node --experimental-strip-types src/server/db/seed/run.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"drizzle-kit": "^0.31.10",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.0",
		"@radix-ui/react-select": "^2.3.7",
		"@tanstack/react-query": "^5.101.4",
		"better-sqlite3": "^13.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	}
}
